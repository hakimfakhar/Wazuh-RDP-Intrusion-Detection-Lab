<group name="windows,authentication,bruteforce,">

<rule id="100507" level="10">
  <if_group>sysmon_event1</if_group>

  <field name="win.eventdata.commandLine" type="pcre2">(schtasks|Register-ScheduledTask)</field>

  <description>Scheduled task creation detected</description>

  <mitre>
    <id>T1053</id>
  </mitre>

  <group>persistence,scheduled_task,</group>

</rule>

</group>

<group name="windows,sysmon,discovery,">

<rule id="100509" level="5">

  <if_group>sysmon_event1</if_group>

  <field name="win.eventdata.commandLine" type="pcre2">whoami(\s+/all)?</field>

  <description>
  User account discovery using whoami command
  </description>

  <mitre>
    <id>T1033</id>
  </mitre>

  <group>
  discovery,user_discovery,
  </group>

</rule>

</group>



 <group name="windows,sysmon,discovery,">

<rule id="100520" level="5">

  <if_group>sysmon_event1</if_group>

  <field name="win.eventdata.commandLine" type="pcre2">tasklist</field>

  <description>
  Process discovery using tasklist detected
  </description>

  <mitre>
    <id>T1057</id>
  </mitre>

  <group>
  discovery,process_discovery,
  </group>

</rule>

</group>

<group name="windows,sysmon,discovery,">

<rule id="100512" level="5">

<if_group>sysmon_event1</if_group>

<field name="win.eventdata.commandLine" type="pcre2">(systeminfo|hostname)</field>

<field name="win.eventdata.image" type="pcre2">(systeminfo|hostname)</field>

<description>
System information discovery detected
</description>

<mitre>
<id>T1082</id>
</mitre>

</rule>

</group>

<group name="windows,sysmon,network_discovery,">

<rule id="100523" level="5">

  <if_group>sysmon_event1</if_group>

  <field name="win.eventdata.commandLine" type="pcre2">ipconfig</field>

  <description>
  Network discovery using ipconfig detected
  </description>

  <mitre>
    <id>T1016</id>
  </mitre>

</rule>

</group>

<group name="windows,sysmon,network_discovery,">

<rule id="100533" level="5">

  <if_group>sysmon_event1</if_group>

  <field name="win.eventdata.commandLine" type="pcre2">route</field>

  <description>
  Route table discovery detected
  </description>

  <mitre>
    <id>T1016</id>
  </mitre>

</rule>

</group>

<group name="windows,bruteforce,authentication,">

<rule id="100200" level="10" frequency="5" timeframe="60">
  <if_matched_sid>60122</if_matched_sid>
  <same_source_ip />
  <description>Possible RDP/Windows brute force attack - multiple failed logons</description>
  <mitre>
    <id>T1110</id>
    <id>T1110.001</id>
  </mitre>
</rule>

</group>


<group name="sysmon,">
  <rule id="255000" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="sysmon.image">\\powershell.exe||\\.ps1||\\.ps2</field>
    <description>Sysmon - Event 1: Bad exe: $(sysmon.image)</description>
    <group>sysmon_event1,powershell_execution,</group>
  </rule>
</group>


<group name="windows,authentication,rdp,">

  
  <rule id="100500" level="5">
    <if_sid>60122</if_sid>
    <field name="win.eventdata.logonType">10</field>
    <description>Failed RDP login attempt</description>
    <group>rdp_failed_login,authentication_failed,</group>
    <mitre>
      <id>T1110</id>
      <id>T1021.001</id>
    </mitre>
  </rule>


  <rule id="100501" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100500</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Possible RDP Brute Force Attack - Multiple failed attempts from $(win.eventdata.ipAddress)</description>
    <group>rdp_bruteforce,authentication_attack,</group>
    <mitre>
      <id>T1110</id>
      <id>T1021.001</id>
    </mitre>
  </rule>

</group>


<group name="windows,sysmon,">
 <rule id="998900" level="13">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">cipher.exe</field>
    <description>Suspicious Cipher.exe execution</description>
 </rule>
</group>
